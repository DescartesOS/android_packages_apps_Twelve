<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/shuffleContainer"
        style="@style/Theme.Twelve.NowPlayingFragment.MediaButton.Tertiary.Container"
        android:layout_width="48dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/previousTrackMaterialButton"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/shuffleMarkerImageView"
            style="@style/Theme.Twelve.NowPlayingFragment.MediaButton.Tertiary.Marker"
            android:importantForAccessibility="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shuffleMaterialButton"
            style="@style/Theme.Twelve.NowPlayingFragment.MediaButton.Standard"
            app:icon="@drawable/ic_shuffle" />

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/previousTrackMaterialButton"
        style="?attr/materialIconButtonFilledTonalStyle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="0dp"
        app:backgroundTint="?attr/colorSurfaceContainerHigh"
        app:icon="@drawable/ic_skip_previous"
        app:iconGravity="textStart"
        app:iconSize="30dp"
        app:iconTint="?attr/colorOnSurface"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/playPauseMaterialButton"
        app:layout_constraintStart_toEndOf="@+id/shuffleContainer"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/playPauseMaterialButton"
        style="?attr/materialIconButtonFilledStyle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:padding="0dp"
        app:backgroundTint="@color/oxygen_red"
        app:elevation="4dp"
        app:icon="@drawable/ic_play_arrow"
        app:iconGravity="textStart"
        app:iconSize="38dp"
        app:iconTint="@android:color/white"
        app:rippleColor="#40FFFFFF"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/nextTrackMaterialButton"
        app:layout_constraintStart_toEndOf="@+id/previousTrackMaterialButton"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nextTrackMaterialButton"
        style="?attr/materialIconButtonFilledTonalStyle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="0dp"
        app:backgroundTint="?attr/colorSurfaceContainerHigh"
        app:icon="@drawable/ic_skip_next"
        app:iconGravity="textStart"
        app:iconSize="30dp"
        app:iconTint="?attr/colorOnSurface"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/repeatContainer"
        app:layout_constraintStart_toEndOf="@+id/playPauseMaterialButton"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/repeatContainer"
        style="@style/Theme.Twelve.NowPlayingFragment.MediaButton.Tertiary.Container"
        android:layout_width="48dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/nextTrackMaterialButton"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/repeatMarkerImageView"
            style="@style/Theme.Twelve.NowPlayingFragment.MediaButton.Tertiary.Marker"
            android:importantForAccessibility="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/repeatMaterialButton"
            style="@style/Theme.Twelve.NowPlayingFragment.MediaButton.Standard"
            app:icon="@drawable/ic_repeat" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
